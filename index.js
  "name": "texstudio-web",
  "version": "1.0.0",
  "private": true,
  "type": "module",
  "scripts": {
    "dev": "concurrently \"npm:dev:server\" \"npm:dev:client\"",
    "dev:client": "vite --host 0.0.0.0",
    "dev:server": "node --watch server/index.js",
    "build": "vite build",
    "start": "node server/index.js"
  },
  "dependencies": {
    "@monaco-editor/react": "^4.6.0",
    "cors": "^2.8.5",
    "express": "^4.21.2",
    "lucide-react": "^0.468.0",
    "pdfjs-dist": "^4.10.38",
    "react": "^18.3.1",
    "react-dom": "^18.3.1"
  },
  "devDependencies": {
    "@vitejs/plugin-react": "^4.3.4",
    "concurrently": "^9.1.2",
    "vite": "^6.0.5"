import express from "express";
import cors from "cors";
import { spawn } from "node:child_process";
import { mkdtemp, writeFile, readFile, rm, stat } from "node:fs/promises";
import { tmpdir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { randomUUID } from "node:crypto";

const app = express();
const PORT = process.env.PORT || 3001;
const MAX_SOURCE_BYTES = 256 * 1024;
const COMPILE_TIMEOUT_MS = 25_000;

app.use(cors());
app.use(express.json({ limit: "300kb" }));

app.get("/api/health", (_req, res) => res.json({ ok: true, engine: "pdflatex" }));

app.post("/api/compile", async (req, res) => {
  const { source, filename = "main.tex" } = req.body || {};
  if (typeof source !== "string" || !source.trim()) {
    return res.status(400).json({ error: "LaTeX source is required." });
  }
  if (Buffer.byteLength(source, "utf8") > MAX_SOURCE_BYTES) {
    return res.status(413).json({ error: "Source exceeds the 256 KB limit." });
  }
  // Keep a single safe .tex filename; never accept a path from the browser.
  const safeName = path.basename(String(filename)).replace(/[^a-zA-Z0-9_.-]/g, "_");
  const texName = safeName.toLowerCase().endsWith(".tex") ? safeName : "main.tex";
  const workDir = await mkdtemp(path.join(tmpdir(), `texstudio-${randomUUID()}-`));
  const texPath = path.join(workDir, texName);
  const pdfPath = path.join(workDir, texName.replace(/\.tex$/i, ".pdf"));

  try {
    await writeFile(texPath, source, { encoding: "utf8", flag: "wx" });
    const result = await runLatex(texName, workDir);
    let pdfInfo;
    try { pdfInfo = await stat(pdfPath); } catch { pdfInfo = null; }
    if (result.code !== 0 || !pdfInfo || pdfInfo.size === 0) {
      return res.status(422).json({
        error: "LaTeX could not compile this document. Check the log for the first error.",
        log: result.output.slice(-12000)
      });
    }
    const pdf = await readFile(pdfPath);
    res.set({
      "Content-Type": "application/pdf",
      "Content-Disposition": `inline; filename="${texName.replace(/\.tex$/i, ".pdf")}"`,
      "Content-Length": pdf.length,
      "X-Compile-Log": "Compilation successful. " + result.output.slice(-1000).replace(/[\r\n]+/g, " ")
    });
    return res.send(pdf);
  } catch (error) {
    console.error("Compile error:", error);
    return res.status(500).json({ error: error.message || "Compilation service failed." });
  } finally {
    await rm(workDir, { recursive: true, force: true }).catch(() => {});
  }
});

function runLatex(texName, cwd) {
  return new Promise((resolve, reject) => {
    // Shell escape is explicitly disabled. Run this service in an isolated,
    // non-root container with no network for any public deployment.
    const child = spawn("pdflatex", [
      "-no-shell-escape", "-interaction=nonstopmode", "-halt-on-error",
      "-file-line-error", "-output-directory", cwd, texName
    ], { cwd, env: { PATH: process.env.PATH, HOME: cwd }, stdio: ["ignore", "pipe", "pipe"] });
    let output = "";
    child.stdout.on("data", chunk => { output += chunk.toString(); });
    child.stderr.on("data", chunk => { output += chunk.toString(); });
    const timer = setTimeout(() => {
      child.kill("SIGKILL");
      reject(new Error("Compilation timed out after 25 seconds."));
    }, COMPILE_TIMEOUT_MS);
    child.on("error", error => { clearTimeout(timer); reject(new Error(`Could not start pdflatex: ${error.message}`)); });
    child.on("close", code => { clearTimeout(timer); resolve({ code, output }); });
  });
}

// Serve the production Vite build when present. In development, Vite serves the UI.
const here = path.dirname(fileURLToPath(import.meta.url));
const distDir = path.resolve(here, "../dist");
app.use(express.static(distDir));
app.get("*", (req, res, next) => {
  if (req.path.startsWith("/api/")) return next();
  res.sendFile(path.join(distDir, "index.html"), error => { if (error) next(); });
});

app.listen(PORT, () => console.log(`TeXStudio API listening on http://localhost:${PORT}`));